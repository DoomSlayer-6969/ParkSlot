{
  "name": "parkslot",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype parking slot booking app: find nearby parking, view slot availability, book and pay online.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "create-admin": "node --env-file-if-exists=.env src/create-admin.js",
    "test": "node --test test/*.test.js",
    "fetch-stations": "node --env-file-if-exists=.env src/fetch-stations.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsqr": "1.4.0",
    "nodemailer": "10.3.1",
    "uqr": "0.1.3"
  }
}
