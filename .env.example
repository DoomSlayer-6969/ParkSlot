# Copy to .env (gitignored); npm start, npm run dev, seed, create-admin and fetch-stations load it.
# Every setting is optional: the value shown is the default. Invalid values stop start-up with an error.

# ---------- Server
PORT=3000
# Base URL used in links inside emails.
PUBLIC_URL=http://localhost:3000
DB_FILE=data/parking.db

# Also serve HTTPS on this port, so the admin portal's camera scanner works on phones and other devices
# on your network (browsers only allow the camera on https:// or http://localhost). Without TLS_CERT_FILE
# and TLS_KEY_FILE, a self-signed certificate is generated in tls/ next to DB_FILE (needs openssl).
#HTTPS_PORT=3443
#TLS_CERT_FILE=
#TLS_KEY_FILE=

# ---------- Email. Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Required when SMTP_HOST is set. Use an address your provider lets you send from.
MAIL_FROM=ParkSlot <no-reply@example.com>

# ---------- Live traffic (prices rise with congestion around a lot)
# Free API key from https://developer.tomtom.com (Traffic API, "Flow Segment Data"). Without a key,
# prices carry no traffic surcharge.
TOMTOM_API_KEY=
# tomtom (the default when TOMTOM_API_KEY is set) or none.
#TRAFFIC_PROVIDER=tomtom
TOMTOM_BASE_URL=https://api.tomtom.com
# Road network detail to match the lot against, 0-22 (10: main roads).
TOMTOM_FLOW_ZOOM=10
# Ask about a lot again once its reading is this old (each lot viewed costs one call per period).
TRAFFIC_CACHE_SECONDS=600
# If the provider fails, keep using the last reading for up to this long, then price without traffic.
TRAFFIC_STALE_SECONDS=3600
TRAFFIC_TIMEOUT_MS=5000
# After the provider fails (rate limit, bad key, outage), leave it alone this long.
TRAFFIC_RETRY_SECONDS=120
# Congestion (0-1) at which traffic counts as moderate, heavy, severe.
TRAFFIC_LEVELS=0.15,0.35,0.6

# ---------- Pricing. Amounts are in the currency's smallest unit (paise: 3000 = ₹30).
# hourly rate = BASE_HOURLY_RATE
#               × (1 + TRAFFIC_PRICE_WEIGHT × congestion)                          (traffic)
#               × (CAPACITY_REFERENCE_SLOTS / lot slots) ^ CAPACITY_PRICE_ELASTICITY (lot size)
# rounded to PRICE_ROUNDING and kept between MIN_HOURLY_RATE and MAX_HOURLY_RATE.
CURRENCY=INR
BASE_HOURLY_RATE=3000
TRAFFIC_PRICE_WEIGHT=1
CAPACITY_REFERENCE_SLOTS=20
CAPACITY_PRICE_ELASTICITY=0.35
PRICE_ROUNDING=500
MIN_HOURLY_RATE=1000
MAX_HOURLY_RATE=20000

# ---------- Map and place search
# Where the map opens (Connaught Place, New Delhi).
DEFAULT_LAT=28.6315
DEFAULT_LNG=77.2167
SEARCH_RADIUS_KM=3
MAX_SEARCH_RADIUS_KM=20
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Limit place search to these countries (comma-separated ISO codes); empty searches worldwide.
GEOCODER_COUNTRY_CODES=in

# ---------- Booking rules
HOLD_MINUTES=10
MAX_BOOKING_HOURS=24
MAX_ADVANCE_DAYS=7
# A start time up to this far in the past counts as "now".
START_GRACE_MINUTES=15
PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------- Accounts
SESSION_DAYS=7
RESET_TOKEN_MINUTES=30
RESET_COOLDOWN_SECONDS=60

# ---------- Metro stations and demo data
# Station list the demo lots are placed around. Refresh it with npm run fetch-stations, which reads
# OpenStreetMap through the Overpass API for STATIONS_AREA (admin_level 4: a state or territory).
STATIONS_FILE=src/data/delhi-metro-stations.json
STATIONS_AREA=Delhi
STATIONS_AREA_ADMIN_LEVEL=4
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Same seed, same layout. Lots are placed at a random spot this far from their station.
SEED_RANDOM_SEED=42
SEED_LOTS_PER_STATION=1
SEED_LOT_MIN_DISTANCE_M=80
SEED_LOT_MAX_DISTANCE_M=450
SEED_LOT_MIN_SLOTS=6
SEED_LOT_MAX_SLOTS=40
# Share of slots booked by other (demo) drivers.
SEED_OCCUPANCY=0.4
DEMO_DRIVER_NAME=Demo User
DEMO_DRIVER_EMAIL=demo@parking.test
DEMO_DRIVER_PASSWORD=demo1234
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=admin@parking.test
DEMO_ADMIN_PASSWORD=admin1234
