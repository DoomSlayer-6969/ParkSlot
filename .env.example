# Copy to .env (gitignored); npm start and npm run dev load it automatically.

# Base URL used in links inside emails.
PUBLIC_URL=http://localhost:3000

# Outgoing email. Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (usually port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Required when SMTP_HOST is set. Use an address your provider lets you send from.
MAIL_FROM=ParkSlot <no-reply@example.com>
